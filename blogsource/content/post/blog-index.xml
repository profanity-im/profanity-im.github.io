<!DOCTYPE html>
<html lang="en">
<head>
    <title>Developer Blog</title>
    <meta charset="utf-8"/>
    <meta http-equiv="Expires" content="-1"/>
    <meta http-equiv="Pragma" content="no-cache"/>
    <meta http-equiv="Cache-Control" content="no-cache"/>
    <link href="../../css/profanity.css" type="text/css" rel="stylesheet"/>
    <link rel="alternate" href="../index.xml" type="application/atom+xml" title="Atom Feed" />
</head>

<body id="blogposts">
    <img class="overlay" src="../../images/profanity_logo_mouth.svg" alt="Profanity Illustration" />
    <header>
        <h1>
            <a href="../../index.html" style="position: relative">
            <span class="kern-ty">Profanity</span>
            </a>
        </h1>
        <h2>Developer Blog</h2>
    </header>
    <nav class="post-nav">
        <a href="../index.xml" title="Atom Feed">Atom Feed</a>
    </nav>
    <article id="manual" style="position: relative">
        <ul>
            <li data-sblg-nav="1" data-sblg-navcontent="1">
                <a href="${sblg-base}.html">${sblg-title}</a>
                <address>${sblg-author}</address>
                <time datetime="${sblg-date}">${sblg-date}</time>
            </li>
        </ul>
    </article>
    <footer>
        <ul class="footer-links">
            <li><a href="http://github.com/profanity-im/profanity">GitHub</a></li>
            <li><a href="https://lists.posteo.de/listinfo/profanity">Mailing List</a></li>
            <li><a href="https://x.com/profanityim">X (Twitter)</a></li>
            <li><a href="xmpp:profanity@rooms.dismail.de?join">XMPP Chat Room</a></li>
            <li><a href="../index.xml">Atom Feed</a></li>
        </ul>
    </footer>
</body>
</html>
